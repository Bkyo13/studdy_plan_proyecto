rules_version = '2';

// Reglas de seguridad de Firestore para StudyPlan.
// Se pegan en la consola: Firestore Database -> Reglas -> Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    // ¿El usuario con sesión es administrador? (su rol se lee de su perfil)
    function esAdmin() {
      return logueado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // ¿El usuario con sesión es el tutor vinculado a este estudiante?
    // Solo cuenta si el estudiante ya aceptó la solicitud (los vínculos
    // viejos, sin 'estado', se toman como aceptados).
    function esTutorDe(estudianteId) {
      let ruta = /databases/$(database)/documents/vinculos/$(request.auth.uid);
      return exists(ruta)
        && get(ruta).data.estudianteId == estudianteId
        && get(ruta).data.get('estado', 'aceptado') == 'aceptado';
    }

    // ---------------- Perfiles: usuarios/{uid} ----------------
    match /usuarios/{uid} {
      // Cualquier usuario con sesión puede leer perfiles (el tutor busca al
      // estudiante por correo y el admin ve los totales).
      allow read: if logueado();

      // Cada quien crea solo SU perfil, y solo como estudiante o tutor.
      // El rol de administrador se asigna a mano desde la consola.
      allow create: if logueado()
                    && request.auth.uid == uid
                    && request.resource.data.rol in ['estudiante', 'tutor'];

      // Cada quien edita solo su perfil y no puede cambiarse el rol.
      allow update: if logueado()
                    && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol;

      // Cada quien puede borrar solo su perfil (al eliminar su cuenta).
      allow delete: if logueado() && request.auth.uid == uid;

      // Logros obtenidos: usuarios/{uid}/logros/{logroId}
      // Solo el propio estudiante los ve, los gana y los borra (al eliminar
      // su cuenta). No se pueden modificar (ni cambiar la fecha).
      match /logros/{logroId} {
        allow read, create, delete: if logueado() && request.auth.uid == uid;
      }

      // Historial de XP: usuarios/{uid}/xp/{tareaId}
      // Lo ve el estudiante y su tutor. Solo el estudiante lo crea (al
      // completar) o lo borra (al deshacer o eliminar su cuenta), con un
      // máximo de 20 puntos por tarea. No se puede editar.
      match /xp/{tareaId} {
        allow read: if logueado()
                    && (request.auth.uid == uid || esTutorDe(uid));
        allow create: if logueado()
                      && request.auth.uid == uid
                      && request.resource.data.puntos is int
                      && request.resource.data.puntos >= 0
                      && request.resource.data.puntos <= 20;
        allow delete: if logueado() && request.auth.uid == uid;
      }
    }

    // ---------------- Catálogos: materias y logros ----------------
    // Todos los usuarios con sesión los leen; solo el admin los modifica.
    match /materias/{materiaId} {
      allow read: if logueado();
      allow write: if esAdmin();
    }
    match /logros/{logroId} {
      allow read: if logueado();
      allow write: if esAdmin();
    }

    // ---------------- Tareas: tareas/{tareaId} ----------------
    match /tareas/{tareaId} {
      // Las lee su dueño y el tutor vinculado a él (solo lectura).
      allow read: if logueado()
                  && (resource.data.estudianteId == request.auth.uid
                      || esTutorDe(resource.data.estudianteId));

      // Solo el estudiante crea, edita y borra SUS tareas, con un máximo
      // de 20 pasos (subtareas) por tarea.
      allow create: if logueado()
                    && request.resource.data.estudianteId == request.auth.uid
                    && request.resource.data.get('subtareas', []).size() <= 20;
      allow update: if logueado()
                    && resource.data.estudianteId == request.auth.uid
                    && request.resource.data.estudianteId == request.auth.uid
                    && request.resource.data.get('subtareas', []).size() <= 20;
      allow delete: if logueado()
                    && resource.data.estudianteId == request.auth.uid;
    }

    // ---------------- Vínculos: vinculos/{tutorId} ----------------
    match /vinculos/{tutorId} {
      // Lo ve el tutor y el estudiante vinculado.
      allow read: if logueado()
                  && (request.auth.uid == tutorId
                      || resource.data.estudianteId == request.auth.uid);

      // El tutor crea o cambia su propio vínculo, siempre como solicitud
      // pendiente (no puede aceptarla él mismo).
      allow create, update: if logueado()
                            && request.auth.uid == tutorId
                            && request.resource.data.tutorId == tutorId
                            && request.resource.data.estado == 'pendiente';

      // El estudiante acepta una solicitud que le enviaron: solo puede
      // cambiar 'estado' de pendiente a aceptado.
      allow update: if logueado()
                    && resource.data.estudianteId == request.auth.uid
                    && resource.data.get('estado', 'aceptado') == 'pendiente'
                    && request.resource.data.estado == 'aceptado'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['estado']);

      // Lo puede quitar el tutor, o el estudiante (al rechazar la solicitud,
      // quitar al tutor o eliminar su cuenta).
      allow delete: if logueado()
                    && (request.auth.uid == tutorId
                        || resource.data.estudianteId == request.auth.uid);
    }

    // Todo lo demás queda cerrado hasta que se agreguen sus reglas.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
